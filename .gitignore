# GeZi（鸽子下载）— Git 忽略规则

# ---------- 用户数据（本地运行产生，绝不入库） ----------
GeZi.config.xml
GeZi.state.json
GeZi.config.xml.*
GeZi.state.json.*
accounts/
Downloads/
