<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi</AssemblyName>
    <RootNamespace>GeZi</RootNamespace>
    <Product>鸽子下载自用版</Product>
    <AssemblyTitle>鸽子下载自用版</AssemblyTitle>
    <!-- 【2026-10-23】版本号升到 2.8.5。
         版本号从程序集读（关于页 / 设置页 / 更新检查都用它），不要在别处手写一份。
         2.8.2：数据目录统一到 %LOCALAPPDATA%\鸽子下载\（解决"换目录启动任务不见了"），
                打包不再携带用户数据。
         2.8.3：修复「一键更新」覆盖失败（下载成功但重启仍是旧版本）。
         2.8.4：① 修复「已收起分组名」用 '\u0001' 做分隔符导致整份 config.xml
                  变成非法 XML（表现为 Cookie 丢失、主题回亮色）；
               ② 修复「全部收起」拿不全分组、以及按钮方向与实际状态不同步；
               ③ 修复失败任务点行内 ▶ 只提示「不可恢复」而无反应
                  （失败态落进 ResumeTask 的 else 分支）；
               ④ 全局 ToolTip 改用主题令牌，暗色主题下不再弹刺眼的纯白方块。
         2.8.5：① 修复「关掉应用再打开，点继续下载一直 0 B/s」（用户实测）。
                  这是五个串联 bug，原版五层全有：
                  · Paused 任务点 ▶ 只 ResumeJob()，不重新取链 → 跨重启必用死链；
                  · 老任务缺 StartFid/ShareRelDir → 重解析在根目录空转、1 秒就失败；
                  · _tasks.Remove 跨线程 → NotSupportedException，续传静默中断；
                  · RunJobs 跨线程改依赖属性 → InvalidOperationException，停在「排队中」；
                  · 进度条从 0 跳变 → 入队时改读 .qmeta 预填真实进度。
               ② 修复「一键更新」三处：
                  · 日志跨次累积，同一份里既有 COPY OK 又有 PARTIAL-FAILED，无法判断成败；
                  · 更新后程序不再自动重启（隐藏窗口继承 + 自我删除抢跑）；
                  · %TEMP% 残留 GeZi-Update-* 空壳与 gezi_filelist.txt（改由启动时清理）。
               ③ 日志框支持右键「清空日志 / 复制全部」，方便复现问题时清屏比对。
         2.8.6：① 修复「并发热不住」——逐字对比原版，二开版缺失了 5 处并发保护机制：
                   · SlowStartGate 分批建连（原版 6 处，二开版 0 处）
                     → 256 个连接一拥而上互抢带宽，都在慢启动；
                   · 软并发闸门（原版改软目标，二开版用 gate.Wait(0) 偷信号量票）
                     → 票不可逆泄漏，并发只降不升，最低塌到 4 路；
                   · 限流收窄下限 4 → 32，并补 15 秒去抖
                     → 一波 429 就把 64 路砸成 4 路；
                   · 动态窃取（代码被整个删掉，只剩一行注释引用不存在的方法）
                     → 尾部塌缩；
                   · 分片下限 512KB → 1MB，补回 capByMinChunk 约束
                     → 3GB 文件被切成 6097 片 × 0.5MB，worker 全在磨小片。
                ② 修复连接预算失效：ThreadAllocator 把 budget×⌈N/concurrency⌉ 当作
                   有效预算，7 个文件算出 1536（应 512）→ 7 个任务各开 256 路
                   = 1792 条连接，远超夸克账号配额，实测「244/256 连接却只跑 1 MB/s」。
                ③ 修复恢复/续传路径绕过分配器（直接用 _settings.Threads）。
                ④ 修复「暂停后恢复要重新建连」：移除二开版独有的 pause.AbortToken
                   （原版 0 处引用），暂停改为原地等待，连接保活。
                ⑤ 修复「改同时下载数不生效」：下载中也立即新建 scheduler 给新任务，
                   但不 Dispose 旧的那个（旧批次自然跑完）→ 不再有设置不生效的观感。
                ⑥ 新增「自动调度」（设置 → 下载与网络）：按总预算 512 自动配对
                   「单文件并发」与「同时下载数」，勾选后两项自动计算并锁定。
                ⑦ 新增并发自动诊断：日志会输出「单连接速度过低 / 连接数上不去 /
                   分片见底」三类结论（每类只报一次），用于判定瓶颈在服务端还是客户端。
         2.8.7：① 修复「恢复全部」把同一文件提交两次导致永久卡死（2.8.6 引入的回归）：
                   2.8.6 为修「没开始却显示下载中」，把暂停恢复状态也改成了 Queued；
                   而 OnResumeAll 靠 State == Queued 反查"要重新取链"的任务，
                   于是同一 task 既走 ResumeJob() 又走 ResumePendingBatchAsync()，
                   同一 Dest 提交两次撞上同路径互斥 → 报「已跳过：同一文件正在下载中」，
                   且状态变 Failed 后再点重试又重复失败，表现为永远恢复不了。
                   修法：改用局部列表 retryTargets 当场登记，把「解除暂停」与
                   「重新取链」两种语义彻底分开，不再靠状态字反查意图。
                ② 新增：网盘「清空当前目录」—— 先统计「共 N 项、总大小 X」再二次确认；
                   只删当前层不递归，每批 100 个分批提交；大小未算完时如实说明。
                ③ 新增：文件列表按文件名排序按钮（默认倒序，目录始终在前）；
                   就地重排，不重新加载目录，不丢多选与滚动位置。
                ④ 新增：下载前询问「是否转存后下载」（默认「否」= 免转存）。
                   用户实测免转存更快，但转存后中转副本在网盘里、续传更稳，
                   故不替用户独断而是问一次；设置页可关闭此询问。
                ⑤ 新增：启动时检测重复目标路径并在日志提醒 —— 同一 Dest 的多条任务
                   只有一条能真正下载，其余必然报「已跳过」，提前告诉用户是哪几行。
         2.8.8：① 新增：在默认浏览器里「边下边播」。
                   · 复用已有的 LocalStreamServer（它早已把"正在增长的目标文件"
                     变成支持 Range 的 HTTP 地址给 VLC 用），再补一个播放页即可 ——
                     浏览器天生支持 mp4/webm 增量播放，**不需要任何转码**，
                     也不引入任何新依赖（本项目仍零 NuGet）。
                   · 任务行「播放」按钮：视频一律走浏览器，未下载/暂停/失败会
                     **自动开始下载**再边下边播。
                   · 右键菜单新增「在浏览器中播放」，与「播放文件」（本地播放器）并存。
                   · 页面与流同端口同源，跨源 Range 的 CORS 问题不存在。
                   · 已完成的任务仍走本地播放器（DownloadScheduler 在下载结束的
                     finally 里把 GetStreamMap 置 null，已完成任务没有流视图）；
                     且本地文件已完整，PotPlayer 零等待、支持所有编码。
                 ② 修复：「下到最后剩几十KB卡死、暂停恢复也没用」。
                   用户实测 248MB 视频卡在 99.9%（1/102 连接、0 B/s），
                   查磁盘发现 497 片里 496 片完整，只剩 idx=443 缺 97KB；
                   直接请求缺口 Range → **HTTP 412**，直链签名早已过期，
                   而恢复走 job.Url 还是同一条死链。五处叠加缺陷：
                     · 412 只让单个 worker 退出，要等所有 worker 都失败才换链；
                     · 只有 45 秒「零字节」才换链，缓慢爬行时永不触发；
                     · tailStall 阈值写死 ≤4，与收尾判据不一致 → 白中止不换链；
                     · 暂停→恢复重置 lastAdvance，越点越不可能触发；
                     · qmeta 的 W 与磁盘不一致时续传定位会落错。
                   修法：412/401/403 立即全局收兵换链；tailStall 改动态阈值
                   min(32, max(3, 并发/8))；新增「慢速爬行」检测（收尾阶段 +
                   <16KB/s + 持续 20 秒 → 换链）；收尾判据从绝对 ≤3 改为相对值。
                 ③ 修复：浏览器播放页「一直提示正在连接下载器，准备播放…」。
                   · 前端：ovLoad 遮罩从未被单独移除（原代码只在 ovWait 显示时
                     才 hideOverlays），一旦 <video> 拿不到数据就永远转圈；
                     现拆出 hideLoading()，轮询拿到合法进度即撤。
                   · 服务端：声明了 Content-Length 却发一半就断（canGrow=false
                     时直接 break）→ 浏览器判定响应截断并无限重试；
                     现改为 Response.Abort()，让页面能显示准确原因。
          2.8.9：① 修复「收尾阶段掉速 / 连接数掉到 0」—— 移植 YunX 的「尾部收缩」。
                   · 根因不在"检测"，而在**分片粒度**：原动态窃取只会把一片切成
                     **两半**，剩 500KB / 32 路时最多只有 2 路在跑，其余 30 路空转。
                   · 修法：当剩余未完成字节 < 在飞路数 × 1MB 时，把当前片按
                     sliceBytes = max(64KB, 剩余/在飞) 均分成最多 64 份，
                     让**全部连接**一起冲最后一段（对比：切半 2 路 vs 收缩 32 路）。
                   · 关键约束：只改 part.E 与追加新片，**不动任何已有的 W** →
                     区间只被切细、从不重排，.qmeta 断点续传天然兼容。
                   · 新增诊断计数 tailShrinkCount，与 splitCount 分开统计。
                ② 「合并后目标文件大小不符」的处理：分片与进度全部保留，可直接重试续传。
                   · 实测现象：2.6GB 文件下到 100% 后报
                     「期望 2600561695，实际 2401647195」（缺 190MB）。
                   · 该报错本身是**保护**：合并后校验发现目标文件没长到应有大小，
                     宁可报错也不交付一个残缺文件。
                   · 已确认：分片目录 .qparts 与 .qmeta 均保留完好，
                     点重试会从断点续传补齐缺失部分，**已下载的 2.4GB 不会重下**。
                   · 用户实测重试成功（见修复记录截图）。 -->
    <Version>2.8.9</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>GeZi.App</StartupObject>
    <!-- 【2026-10-03】应用图标：exe 文件图标 + 任务栏/Alt-Tab 图标。
         图标是"衔橄榄枝的鸽子"，与「鸽子下载自用版」对应（用户提供）。
         另外把 .ico 也作为 WPF Resource 发布，供窗口 Icon 使用。 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- 【2026-10-04】PathMap：把编译机的绝对路径映射成占位前缀。
         ⚠️ 不加这一条，编译器会把自己的 PDB 路径
         `C:\Users\<用户名>\Desktop\GeZi\src\...\GeZi.pdb` 原样写进 exe/dll 的
         debug directory → 发给别人时**泄漏你的用户名和目录结构**（本轮实测发现）。
         PathMap 只改**二进制里记录的路径**，不改实际文件位置 →
         本机 VS 调试照常（.pdb 仍在 bin 下），只是别人看到的是 `/_/`。
         （等价于 C++ 的 /pathmap，.NET 从 Roslyn 起支持。） -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口图标（Window.Icon 用）。PNG 版给界面里的小尺寸 Logo 用，
         因为 WPF 对 .ico 的解码只会取第一帧（16x16），放大到 28px 会糊。 -->
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app-logo.png" />
    <!-- 赞赏码（2026-10-09 用户提供的新图：「躬行小舟」的赞赏码，
         取代原来从 Flet 版 APP_REWARD_LG_B64 解出来的那份） -->
    <Resource Include="Resources\reward-xiaozhou.png" />
    <!-- 【2026-10-24】浏览器播放页模板。
         作为 EmbeddedResource 而不是 Resource：
         Resource 走 WPF 的 pack:// URI，取原始文本要绕 ResourceManager 的 BAML 流；
         EmbeddedResource 直接 GetManifestResourceStream 读字符串，最直白。
         资源名 = 根命名空间 + 目录 + 文件名 → GeZi.Resources.player.html -->
    <EmbeddedResource Include="Resources\player.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeZi.Core\GeZi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 零 NuGet：JSON 用框架自带的 DataContractJsonSerializer（历史记录/未完成任务持久化）。
         不要引 System.Web.Extensions —— 它依赖 System.Web，会让 WPF 的 XAML 编译器报 MC1000。 -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
