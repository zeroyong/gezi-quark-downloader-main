<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi</AssemblyName>
    <RootNamespace>GeZi</RootNamespace>
    <Product>鸽子下载自用版</Product>
    <AssemblyTitle>鸽子下载自用版</AssemblyTitle>
    <!-- 【2026-10-23】版本号升到 2.8.5。
         版本号从程序集读（关于页 / 设置页 / 更新检查都用它），不要在别处手写一份。
         2.8.2：数据目录统一到 %LOCALAPPDATA%\鸽子下载\（解决"换目录启动任务不见了"），
                打包不再携带用户数据。
         2.8.3：修复「一键更新」覆盖失败（下载成功但重启仍是旧版本）。
         2.8.4：① 修复「已收起分组名」用 '\u0001' 做分隔符导致整份 config.xml
                  变成非法 XML（表现为 Cookie 丢失、主题回亮色）；
               ② 修复「全部收起」拿不全分组、以及按钮方向与实际状态不同步；
               ③ 修复失败任务点行内 ▶ 只提示「不可恢复」而无反应
                  （失败态落进 ResumeTask 的 else 分支）；
               ④ 全局 ToolTip 改用主题令牌，暗色主题下不再弹刺眼的纯白方块。
         2.8.5：① 修复「关掉应用再打开，点继续下载一直 0 B/s」（用户实测）。
                  这是五个串联 bug，原版五层全有：
                  · Paused 任务点 ▶ 只 ResumeJob()，不重新取链 → 跨重启必用死链；
                  · 老任务缺 StartFid/ShareRelDir → 重解析在根目录空转、1 秒就失败；
                  · _tasks.Remove 跨线程 → NotSupportedException，续传静默中断；
                  · RunJobs 跨线程改依赖属性 → InvalidOperationException，停在「排队中」；
                  · 进度条从 0 跳变 → 入队时改读 .qmeta 预填真实进度。
               ② 修复「一键更新」三处：
                  · 日志跨次累积，同一份里既有 COPY OK 又有 PARTIAL-FAILED，无法判断成败；
                  · 更新后程序不再自动重启（隐藏窗口继承 + 自我删除抢跑）；
                  · %TEMP% 残留 GeZi-Update-* 空壳与 gezi_filelist.txt（改由启动时清理）。
               ③ 日志框支持右键「清空日志 / 复制全部」，方便复现问题时清屏比对。
         2.8.6：① 修复「并发热不住」——逐字对比原版，二开版缺失了 5 处并发保护机制：
                   · SlowStartGate 分批建连（原版 6 处，二开版 0 处）
                     → 256 个连接一拥而上互抢带宽，都在慢启动；
                   · 软并发闸门（原版改软目标，二开版用 gate.Wait(0) 偷信号量票）
                     → 票不可逆泄漏，并发只降不升，最低塌到 4 路；
                   · 限流收窄下限 4 → 32，并补 15 秒去抖
                     → 一波 429 就把 64 路砸成 4 路；
                   · 动态窃取（代码被整个删掉，只剩一行注释引用不存在的方法）
                     → 尾部塌缩；
                   · 分片下限 512KB → 1MB，补回 capByMinChunk 约束
                     → 3GB 文件被切成 6097 片 × 0.5MB，worker 全在磨小片。
                ② 修复连接预算失效：ThreadAllocator 把 budget×⌈N/concurrency⌉ 当作
                   有效预算，7 个文件算出 1536（应 512）→ 7 个任务各开 256 路
                   = 1792 条连接，远超夸克账号配额，实测「244/256 连接却只跑 1 MB/s」。
                ③ 修复恢复/续传路径绕过分配器（直接用 _settings.Threads）。
                ④ 修复「暂停后恢复要重新建连」：移除二开版独有的 pause.AbortToken
                   （原版 0 处引用），暂停改为原地等待，连接保活。
                ⑤ 修复「改同时下载数不生效」：下载中也立即新建 scheduler 给新任务，
                   但不 Dispose 旧的那个（旧批次自然跑完）→ 不再有设置不生效的观感。
                ⑥ 新增「自动调度」（设置 → 下载与网络）：按总预算 512 自动配对
                   「单文件并发」与「同时下载数」，勾选后两项自动计算并锁定。
                ⑦ 新增并发自动诊断：日志会输出「单连接速度过低 / 连接数上不去 /
                   分片见底」三类结论（每类只报一次），用于判定瓶颈在服务端还是客户端。 -->
    <Version>2.8.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>GeZi.App</StartupObject>
    <!-- 【2026-10-03】应用图标：exe 文件图标 + 任务栏/Alt-Tab 图标。
         图标是"衔橄榄枝的鸽子"，与「鸽子下载自用版」对应（用户提供）。
         另外把 .ico 也作为 WPF Resource 发布，供窗口 Icon 使用。 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- 【2026-10-04】PathMap：把编译机的绝对路径映射成占位前缀。
         ⚠️ 不加这一条，编译器会把自己的 PDB 路径
         `C:\Users\<用户名>\Desktop\GeZi\src\...\GeZi.pdb` 原样写进 exe/dll 的
         debug directory → 发给别人时**泄漏你的用户名和目录结构**（本轮实测发现）。
         PathMap 只改**二进制里记录的路径**，不改实际文件位置 →
         本机 VS 调试照常（.pdb 仍在 bin 下），只是别人看到的是 `/_/`。
         （等价于 C++ 的 /pathmap，.NET 从 Roslyn 起支持。） -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口图标（Window.Icon 用）。PNG 版给界面里的小尺寸 Logo 用，
         因为 WPF 对 .ico 的解码只会取第一帧（16x16），放大到 28px 会糊。 -->
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app-logo.png" />
    <!-- 赞赏码（2026-10-09 用户提供的新图：「躬行小舟」的赞赏码，
         取代原来从 Flet 版 APP_REWARD_LG_B64 解出来的那份） -->
    <Resource Include="Resources\reward-xiaozhou.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeZi.Core\GeZi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 零 NuGet：JSON 用框架自带的 DataContractJsonSerializer（历史记录/未完成任务持久化）。
         不要引 System.Web.Extensions —— 它依赖 System.Web，会让 WPF 的 XAML 编译器报 MC1000。 -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
