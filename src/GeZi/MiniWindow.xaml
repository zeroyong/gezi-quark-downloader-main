<Window x:Class="GeZi.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="鸽子下载 · 小窗"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        ⚠️⚠️ 这里**不能**用 AllowsTransparency="True"（2026-10-03 改）。
        分层窗口会强制关掉 ClearType，文字退化成灰度抗锯齿 —— 用户看到的
        「这个窗口太糊了」就是这个原因，跟字号/字体都无关。
        现在跟主窗一样走 **WindowChrome**：无系统边框但**不是分层窗口**，
        ClearType 正常；圆角交给 DWM（见 MiniWindow 的 Loaded），
        阴影也由系统给，不再需要 WPF 的 DropShadowEffect。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootCard"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1">
        <StackPanel Width="250">
            <!-- 标题栏（WindowChrome 的 CaptionHeight 已经让这条能拖动，
                 里面的按钮要 IsHitTestVisibleInChrome 才点得到） -->
            <Grid x:Name="TitleBar" Height="38" Background="Transparent">
                <Path Data="{StaticResource IconDownload}" Stretch="Uniform"
                      Width="14" Height="14" Margin="12,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
                <TextBlock x:Name="TitleText" Text="下载中"
                           Margin="32,0,36,0" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- 收起：只是隐藏小窗，程序继续在托盘跑 -->
                <Button x:Name="HideBtn" Click="OnHideClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="收起小窗"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0" Width="26" Height="26"
                        Style="{StaticResource CaptionCloseButton}"
                        ToolTip="收起小窗（程序继续在托盘运行）">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="10" Height="10"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 全局统计：总速度 / 总进度 / 剩余**文件数**
     ⚠️ 2026-10-03 用户要求：不要逐任务的进度条（列表太长太杂），
     只留这三项；「剩余」也不标时间，改成**还剩几个文件**。 -->
            <Border Margin="10,0,10,0" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource SurfaceSunkenBrush}">
                <Grid>
                    <!-- 三列**等分**：原来后两列是 Auto，结果「总速度」孤零零在最左、
                        另两个挤在最右，看着不平衡（小窗收窄后更明显）。 -->
                    <!-- 速度那一列给多一点："5.43 MB/s" 比 "0/3"、"3 个" 长得多，
                         三等分会在 260 宽下叠字（实测渲染图里 5.43 MB/s 压到 0/3 上）。 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="总速度" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="TotalSpeedText" Text="—"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Style="{StaticResource NumericText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="已完成" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="TotalPercentText" Text="—"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Style="{StaticResource NumericText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="剩余文件" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="RemainText" Text="—"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Style="{StaticResource NumericText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部：打开主窗口 -->
            <Border Margin="0,10,0,0" Padding="10,5"
                    AutomationProperties.Name="打开主窗口"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="{DynamicResource SurfaceAltBrush}"
                    MouseLeftButtonUp="OnOpenMainClick" Cursor="Hand">
                <TextBlock Text="打开主窗口" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
