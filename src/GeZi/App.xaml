<Application x:Class="GeZi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ⚠️ 这里**故意不写 StartupUri**（2026-10-03 改）。
        原因：单实例判重是在 OnStartup 里做的，而 StartupUri 会在 OnStartup 返回后
        才创建主窗口 —— 于是「已有实例」分支里排队的 Shutdown() 要等整个启动序列
        （加载 5 个资源字典 + 构造 MainWindow）跑完才执行。实测第二实例因此每次
        白跑 **2.2 秒**、白占几十 MB。改成手动 new MainWindow().Show() 之后，
        判重分支可以在**任何资源加载之前**直接退出。

        ShutdownMode=OnExplicitShutdown：本程序有托盘驻留 + 悬浮小窗，
        "最后一个窗口关闭"不能代表退出（关小窗、隐藏主窗都不该退），
        退出时机由 App/MainWindow 显式控制（见 ExitApp）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
                资源字典合并顺序很重要：
                Colors（Color）→ Brushes（由 Colors 派生）→ Icons → ScrollBar（依赖 Brushes）
                → Styles（依赖以上全部）。
                调试技巧：XAML 里 <Style> 必须用 StaticResource 引（net48 的 DynamicResource
                引 Style 有 bug），但 Style 内部的颜色/画刷一律 DynamicResource，换主题才能即时生效。

                ⚠️ Colors 这一层是**可切换的**：默认加载 Colors.Light.xaml，
                   运行时由 ThemeManager 把这一项原位换成 Colors.Dark.xaml 实现深色模式。
                   两份色源键名逐一对齐（各 36 个），所以换过去不会有控件"找不到资源"。
                   ⚠️ 千万**不要**把 Colors 挪到 Brushes 后面 —— Brushes 里每个画刷的 Color
                      都是 DynamicResource 引用 Colors 的键，顺序反了会取不到色。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.Light.xaml" />
                <ResourceDictionary Source="Resources/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/ScrollBar.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
