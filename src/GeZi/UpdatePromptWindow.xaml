<Window x:Class="GeZi.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新可用"
        Width="460"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        「更新详情」窗口（2026-10-22 双源版）：用户点「检查更新」发现新版本后弹出。
        支持两种动作：「一键更新」自动下载安装包并覆盖重启（来源可自动安装时），
        「查看详情」在浏览器打开来源页（GitHub Release / 夸克分享）手动下载。
        ⚠️ 跟关于/主窗一样走 WindowChrome（非分层窗口 → 文字清晰），圆角交给 DWM。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44" Background="Transparent">
                <TextBlock Text="更新可用" Margin="18,0,44,0"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Margin="20,4,20,20">
                <!-- 版本对比 + 发布信息徽章 -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="NewVersionText" Text="发现新版本 v?"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionText" Text="当前版本 v?"
                                   FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6"
                            Padding="8,4" Margin="8,0,0,0">
                        <TextBlock x:Name="SizeText" Text="?" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <!-- 来源徽章：GitHub Releases / 夸克网盘分享 -->
                <TextBlock x:Name="SourceText" Text="?"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource PrimaryBrush}"/>

                <!-- 更新说明（来源 Notes 原文，只读滚动） -->
                <TextBlock Text="更新说明" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="10">
                    <TextBox x:Name="BodyText" IsReadOnly="True" BorderThickness="0"
                              Background="Transparent" FontSize="11" TextWrapping="Wrap"
                              VerticalScrollBarVisibility="Auto" MaxHeight="180"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- 进度条（一键更新时显示） -->
                <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,14,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource SurfaceSunkenBrush}"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- 底部按钮：左「忽略此版本」，中「查看详情」，右「一键更新」（主）。
                     要忽略必须明确点它（以前挂在别处，容易手滑永久屏蔽）。 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="忽略此版本" Click="OnIgnoreClick"
                            AutomationProperties.Name="忽略此版本"
                            Style="{StaticResource GhostButton}"
                            MinWidth="96" HorizontalAlignment="Left"
                            ToolTip="之后不再提示这个版本；想恢复：再点一次「检查更新」"/>
                    <Button x:Name="ViewBtn" Grid.Column="2" Content="查看详情" Click="OnViewClick"
                            AutomationProperties.Name="查看更新详情"
                            Style="{StaticResource GhostButton}"
                            MinWidth="96" Margin="0,0,10,0"
                            ToolTip="在浏览器打开来源页，手动下载安装包"/>
                    <Button x:Name="UpdateBtn" Grid.Column="3" Content="一键更新" Click="OnUpdateClick"
                            AutomationProperties.Name="一键更新"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="96"
                            ToolTip="自动下载安装包并覆盖重启（无需手动操作）"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
