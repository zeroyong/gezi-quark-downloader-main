<Window x:Class="GeZi.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        SizeToContent="Height"
        Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        SnapsToDevicePixels="True">

    <!--
        自绘统一对话框（取代系统 MessageBox）。
        系统 MessageBox 是 Win32 经典外观（方角、微软雅黑旧字号、
        方形按钮、左上角大图标），跟本项目自绘的圆角卡片 UI 完全两个世界。
        这里按同一套设计令牌重画：圆角 14、淡阴影、主色按钮。
    -->
    <Border x:Name="RootCard" Margin="16" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowStrongColor}"
                              BlurRadius="30" ShadowDepth="3"
                              Direction="270" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- 「不再提示」勾选行：默认折叠，只有调用方要求时才显示 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDown">
                <TextBlock x:Name="TitleText" Text="提示"
                           Margin="20,0,44,0" VerticalAlignment="Center"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CloseBtn" Click="OnCancel"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}"
                        ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 正文：图标 + 主文案 -->
            <Grid Grid.Row="1" Margin="20,2,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox" Grid.Column="0" Width="38" Height="38"
                        CornerRadius="19" VerticalAlignment="Top" Margin="0,1,14,0"
                        Background="{DynamicResource PrimaryLightBrush}">
                    <Path x:Name="IconPath" Data="{StaticResource IconInfo}" Stretch="Uniform"
                          Width="20" Height="20" HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Border>

                <TextBlock x:Name="BodyText" Grid.Column="1" TextWrapping="Wrap"
                           LineHeight="21" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 「不再提示」勾选框（2026-10-03 新增）
                 用户要求：「在这个弹窗的右下角可以勾选此后不再提示」。
                 放在按钮行**正上方**、右对齐 —— 就是右下角那片区域，
                 又不跟按钮挤在同一行。默认折叠，只有调用方要求时才出现。 -->
            <CheckBox x:Name="DontAskCheck" Grid.Row="2"
                      Content="此后不再提示" Visibility="Collapsed"
                      HorizontalAlignment="Right" Margin="20,16,20,0"
                      Style="{StaticResource AppCheckBox}"/>

            <!-- 按钮区 -->
            <StackPanel x:Name="ButtonRow" Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="20,20,20,18">
                <Button x:Name="Btn3" Click="OnButton3" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" MinWidth="84" Visibility="Collapsed"/>
                <Button x:Name="Btn2" Click="OnButton2" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" MinWidth="84"/>
                <Button x:Name="Btn1" Click="OnButton1" Style="{StaticResource PrimaryButton}"
                        MinWidth="84"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
