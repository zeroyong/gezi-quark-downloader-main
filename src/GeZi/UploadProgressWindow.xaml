<Window x:Class="GeZi.UploadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="上传中"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        上传进度窗口（2026-11-10 新增）。

        【为什么不用 AppDialog】上传是**持续进行**的操作，需要一个能实时刷新的
        进度条 + 随时可点的取消按钮，静态消息框做不到。

        【为什么点外部不关闭、没有「确定」】上传真在后台跑，用户随手关掉会以为停了。
        唯一出口是「取消上传」（真的会中止并清掉已传分片）或等它自己完成。
        ⚠️ 走 WindowChrome（非分层窗口 → 文字清晰），与其它窗口一致。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏：没有关闭按钮（见上方说明） -->
            <Grid Height="44" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="正在上传" Margin="18,0,18,0"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>

            <StackPanel Margin="20,4,20,20">
                <!-- 第几个 / 共几个 -->
                <TextBlock x:Name="CountText" Text="正在上传"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- 文件名（太长就省略，不换行撑高窗口） -->
                <TextBlock x:Name="NameText" Text=""
                           Margin="0,6,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 进度条 -->
                <Border Margin="0,14,0,0" Height="6" CornerRadius="3"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        ClipToBounds="True">
                    <Border x:Name="BarFill" HorizontalAlignment="Left"
                            CornerRadius="3" Width="0"
                            Background="{DynamicResource PrimaryBrush}"/>
                </Border>

                <!-- 百分比 + 速度（2026-11-10 加：速度比进度条更能反映"还要多久"） -->
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PercentText" Grid.Column="0" Text="0%"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpeedText" Grid.Column="1" Text=""
                               Margin="10,0,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="EtaText" Grid.Column="2" Text=""
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 阶段文案 + 已传/总共 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PhaseText" Grid.Column="0" Text="正在校验文件…"
                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="SizeText" Grid.Column="1" Text=""
                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>

                <!-- 操作区 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Grid.Column="0"
                               Text="上传期间可以继续用其它页面"
                               VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <Button x:Name="CancelBtn" Grid.Column="1" Click="OnCancelClick"
                            Content="取消上传"
                            Padding="16,7" MinWidth="92"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="取消上传"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
