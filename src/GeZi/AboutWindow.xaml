<Window x:Class="GeZi.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 鸽子下载"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        「关于」窗口（2026-10-03 新增，用户要求「和 Python Flet 版那个差不多」）。
        ⚠️ 跟主窗/小窗一样走 WindowChrome（不是分层窗口 → ClearType 正常、文字清晰），
           圆角交给 DWM（见 Loaded 里的 ApplyRoundedCorners）。
        ⚠️ CaptionHeight=44 让标题栏能拖动，里面的关闭按钮要 IsHitTestVisibleInChrome。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44" Background="Transparent">
                <TextBlock Text="关于 鸽子下载" Margin="18,0,44,0"
                           VerticalAlignment="Center"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,0,18,18">

                    <!-- 品牌行：图标 + 名称 / 版本 / 一句话 -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/app-logo.png" Width="56" Height="56"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="鸽子下载" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" Text="夸克网盘 · 直链助手"
                                       FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="分享转存 · 直链解析 · 高速下载"
                                       FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 作者 B 站（点击跳转） -->
                    <Button x:Name="BiliBtn" Click="OnBiliClick"
                            AutomationProperties.Name="打开作者B站主页"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Padding="0">
                        <TextBlock x:Name="BiliText" Text="作者 B 站：b23.tv/gIoEfQM（点击跳转）"
                                   FontSize="11.5" TextDecorations="Underline"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Button>

                    <!-- 开源地址（点击跳转）—— 与 B 站链接同构 -->
                    <Button x:Name="RepoBtn" Click="OnRepoClick"
                            AutomationProperties.Name="打开项目开源地址"
                            HorizontalAlignment="Left" Margin="0,5,0,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Padding="0">
                        <TextBlock x:Name="RepoText"
                                   Text="开源地址：github.com/huaotem-bot/gezi-quark-downloader"
                                   FontSize="11.5" TextDecorations="Underline"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Button>

                    <!-- 应用简介 -->
                    <TextBlock Text="应用简介" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                    <TextBlock Style="{StaticResource ProseText}" TextWrapping="Wrap"
                               Text="一款夸克网盘分享链接解析与高速下载工具。粘贴分享链接就能直接下载，也可以扫码登录后浏览、下载自己的网盘文件。"/>
                    <TextBlock Style="{StaticResource ProseText}" TextWrapping="Wrap"
                               Margin="0,8,0,0"><Run Text="本项目" /><Run
                                Text="完全开源" FontWeight="SemiBold" /><Run
                                Text="，采用 GPL-3.0 许可，全部源码公开可审计。软件无广告、无遥测、不收集任何用户数据；登录凭据仅以 Windows DPAPI 加密保存在本机，不会外传。" /></TextBlock>

                    <!-- 功能特性 -->
                    <TextBlock Text="功能特性" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                    <StackPanel x:Name="FeatureList"/>

                    <!-- 开源许可 -->
                    <TextBlock Text="开源许可" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                    <TextBlock Style="{StaticResource ProseText}" TextWrapping="Wrap"
                               Text="本项目基于 GNU General Public License v3.0 发布：你可以自由使用、修改和再分发，但衍生作品必须以同样的许可开源。第三方组件及其许可详见仓库内的 THIRD-PARTY-NOTICES.md。" />

                    <!-- 赞赏支持 -->
                    <TextBlock Text="赞赏支持" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- ⚠️ 用真 Button 而不是 Border+MouseLeftButtonUp：
                             Border 没有 automation peer，**UIA 树里根本找不到它**（点不到、也测不了）；
                             Button 有 InvokePattern，键盘 Tab+回车 也能用。 -->
                        <Button x:Name="QrBtn" Click="OnQrClick"
                                Style="{StaticResource IconGhostButton}"
                                Width="Auto" Height="Auto" Padding="0"
                                AutomationProperties.Name="赞赏码（点击放大）"
                                ToolTip="点击放大">
                            <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="8" Padding="6"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Image Source="/Resources/reward-qr.png" Width="150" Height="150"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Button>
                        <TextBlock Text="点击二维码可放大 · 如果觉得好用，欢迎扫码赞赏支持"
                                   FontSize="10.5" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="七十鸽 的赞赏码" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="0,3,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 底部 -->
                    <Button x:Name="OkBtn" Content="关闭" Click="OnCloseClick"
                            AutomationProperties.Name="关闭"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinWidth="96" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
