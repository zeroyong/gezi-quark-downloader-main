<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!--
      Server GC：按 CPU 核建立独立 GC 堆并并行收集。
      本项目单文件可开 512 个连接，线程数极多；Workstation GC 的
      stop-the-world 暂停会被放大，表现为 CPU 占用极高。
      代价是内存占用上升（每核一份堆），对下载器不是瓶颈。
    -->
    <gcServer enabled="true" />

    <!-- 并发 GC：Gen2 收集与用户线程并行，减少长暂停。 -->
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
