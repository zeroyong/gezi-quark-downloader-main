<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!--
      Server GC（2026-10-02 新增）。

      为什么需要：本项目默认用的是 Workstation GC —— 单线程收集，
      且 Gen0/Gen1 收集会**暂停所有托管线程**（stop-the-world）。
      下载器在 512 并发下线程数很多，这个暂停的绝对开销会被放大，
      表现就是"CPU 占用非常高"。

      Server GC 按 CPU 核建立独立的 GC 堆并**并行收集**，
      专为高吞吐场景设计。代价是内存占用上升（每核一份堆），
      对下载器而言内存不是瓶颈，这笔交易划算。
    -->
    <gcServer enabled="true" />

    <!--
      并发 GC：Gen2 收集与用户线程并行执行，降低出现长暂停的概率。
      （Server GC 下本项通常被忽略，显式写出以表明意图。）
    -->
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
